{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User account information and roles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "teacher"] },
        "assignedClass": { "type": "object" }
      },
      "required": ["id", "name", "email", "role"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "users",
      "description": "Store user profiles keyed by UID"
    }
  }
}
